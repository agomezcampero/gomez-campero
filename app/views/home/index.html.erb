<% content_for :title, "Agustín Gómez Campero · Desarrollador de Software" %>

<header class="hero">
  <div class="container">
    <p class="hero__eyebrow">Agustín Gómez Campero</p>
    <h1 class="hero__title">Desarrollador de Software con más de 10 años de experiencia</h1>
    <div class="hero__actions">
      <%= link_to "Agendar una reunión gratis", "https://calendly.com/agomezcampero/30min", class: "btn btn--primary" %>
      <%= link_to "Contacto", "#contact", class: "btn btn--plain" %>
    </div>
  </div>
</header>

<section class="section">
  <div class="container">
    <h2 class="section__title">Mis Servicios</h2>

    <div class="services">
      <article class="service">
        <svg class="service__icon" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
        <h3 class="service__title">Automatización de procesos internos</h3>
        <p>Optimiza tus operaciones con soluciones personalizadas.</p>
      </article>

      <article class="service">
        <svg class="service__icon" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9m-9 9a9 9 0 0 1 9-9"/></svg>
        <h3 class="service__title">Desarrollo de portales de clientes</h3>
        <p>Mejora la experiencia de tus clientes con portales intuitivos.</p>
      </article>

      <article class="service">
        <svg class="service__icon" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.2 5.3L20 10.5l-5.8 2.2L12 18l-2.2-5.3L4 10.5l5.8-2.2z"/><path d="M19 17l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>
        <h3 class="service__title">Soluciones con IA</h3>
        <p>Desarrolla aplicaciones integrando inteligencia artificial con los últimos modelos de OpenAI y Anthropic.</p>
      </article>

      <article class="service">
        <svg class="service__icon" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
        <h3 class="service__title">Desarrollo de aplicaciones móviles</h3>
        <p>Crea aplicaciones móviles intuitivas y eficientes en Android y iOS.</p>
      </article>
    </div>
  </div>
</section>

<section class="section section--tinted">
  <div class="container">
    <h2 class="section__title">Clientes</h2>
    <p class="section__lead">He trabajado para múltiples empresas desarrollando aplicaciones web y móviles.</p>
    <%= render "logos", logos: clients %>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section__title">Mi historia profesional</h2>
    <p class="section__lead">Fui el primer ingeniero en Fanatiz, trabajé en Platanus y últimamente en Cleary, una startup de Silicon Valley.</p>
    <%= render "logos", logos: previous_companies %>

    <p class="section__lead">Durante mi tiempo en Platanus, me tocó trabajar con grandes startups chilenas.</p>
    <%= render "logos", logos: platanus_startups %>
  </div>
</section>

<section class="section section--tinted">
  <div class="container">
    <h2 class="section__title">Lo que dicen mis clientes</h2>

    <figure class="testimonial">
      <blockquote class="testimonial__quote">
        <p>“Se dice que en el mundo de los programadores existen “Programadores 10X”, osea, hacen la pega de 10 ingenieros. Agustín es uno de esos. El proyecto estuvo listo en la mitad del tiempo que pensé.”</p>
      </blockquote>
      <figcaption class="testimonial__author">
        <%= image_tag "people/pablito.jpeg", alt: "", class: "testimonial__avatar" %>
        <span>
          <strong>Pablo Riedemann</strong>
          Co-Host Animales Financieros
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<section id="contact" class="section">
  <div class="container container--narrow">
    <h2 class="section__title">¿Listo para optimizar tu negocio?</h2>
    <p class="section__lead">Contáctame hoy para discutir cómo puedo ayudarte a llevar tu negocio al siguiente nivel con soluciones de software personalizadas.</p>

    <div class="contact">
      <%= link_to "Agendar una reunión gratis", "https://calendly.com/agomezcampero/30min", class: "btn btn--primary btn--block" %>

      <%= mail_to "agustin@gomezcampero.com", class: "btn btn--secondary btn--block" do %>
        <svg class="btn__icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/></svg>
        agustin@gomezcampero.com
      <% end %>

      <%= link_to "https://wa.me/56982326182", class: "btn btn--secondary btn--block" do %>
        <%= image_tag "logos/whatsapp.svg", alt: "", class: "btn__icon" %>
        +56 9 8232 6182
      <% end %>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">© <%= Date.current.year %> Agustín Gómez Campero</div>
</footer>
